# =============================================================================
# Cycle of Chart - Environment Variables Configuration
# =============================================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=3000
VITE_APP_ID=cycle-of-chart

# Database Configuration (PostgreSQL / Supabase / MySQL)
# Leave empty or provide a valid connection string (e.g., postgresql://postgres:password@localhost:5432/cycle_of_chart)
DATABASE_URL=

# Authentication Secrets (JWT & Session Cookies)
JWT_SECRET=cycle_of_chart_secure_jwt_token_secret_key_2026_production
COOKIE_SECRET=cycle_of_chart_secure_cookie_secret_key_2026

# Admin Owner Configuration
OWNER_OPEN_ID=admin

# Supabase Integration (Optional - Database & Auth)
SUPABASE_URL=https://pxrcaqmjmsvldhiyuacx.supabase.co
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=https://pxrcaqmjmsvldhiyuacx.supabase.co
VITE_SUPABASE_ANON_KEY=

# OAuth Server (Optional)
OAUTH_SERVER_URL=

# Forge / Storage Proxy API (Optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Email / SMTP Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cycleofchart.com
